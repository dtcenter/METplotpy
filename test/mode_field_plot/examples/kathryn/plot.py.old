import numpy as np
import matplotlib.pyplot as plt
import matplotlib.colors as mcolors
import cartopy.crs as ccrs
import cartopy.feature as cfeature
import netCDF4 as nc

# Load the NetCDF file
ds = nc.Dataset('mode_KWBC_APCP_24_vs_IMERG_APCP_24_240000L_20240204_000000V_240000A_R1_T2_obj.nc')

# Adjust these to match your variable and coordinate names
# (check with: print(ds.variables.keys()))
data = ds.variables['fcst_raw'][:]
lat = ds.variables['lat'][:]
lon = ds.variables['lon'][:]

# Create custom colormap - white for low values, then cyan through red
# Similar to what ncview shows but with white background instead of blue
cmap = plt.cm.jet  # or customize further

# Set up the plot - adjust figsize for the narrower latitude band
fig, ax = plt.subplots(figsize=(14, 4),  # reduced height for narrower domain
                        subplot_kw={'projection': ccrs.PlateCarree()})

ax.set_facecolor('lightgrey')

mesh = ax.pcolormesh(lon, lat, data_masked,
                     cmap=cmap,
                     transform=ccrs.PlateCarree())

# Limit to tropical band
ax.set_extent([-180, 180, -20, 20], crs=ccrs.PlateCarree())

# Set background to grey (replaces white in ncview)
ax.set_facecolor('lightgrey')

# Plot the data - masked/zero values will show as white
data_masked = np.ma.masked_less_equal(data, 0.01)  # adjust threshold as needed
mesh = ax.pcolormesh(lon, lat, data_masked,
                     cmap=cmap,
                     transform=ccrs.PlateCarree())

# More compact colorbar
plt.colorbar(mesh, ax=ax, label='APCP_24 (mm)',
             shrink=0.5,
             aspect=20,
             pad=0.02)

# Add coastlines and borders
ax.add_feature(cfeature.COASTLINE, linewidth=0.5)
ax.add_feature(cfeature.BORDERS, linewidth=0.5)

# Add gridlines
ax.gridlines(draw_labels=True, linewidth=0.5, color='gray', alpha=0.5)

plt.title('APCP_24')
plt.tight_layout()
plt.savefig('apcp_mask_noaa.png', dpi=300, bbox_inches='tight')
plt.show()
