#%Module######################################################################
##
##      METplotpy
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the METplotpy-13.0.0
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

module load ncarenv/25.10
module load intel/2025.2.1

prepend-path PATH /glade/work/dtcrt/METplus/casper/miniconda/miniconda3/envs/metplus_v13.0_py3.14/bin

setenv METPLOTPY_SOURCE /glade/work/dtcrt/METplus/casper/components/METplotpy/installations/METplotpy-13.0.0
setenv METPLOTPY_BASE /glade/work/dtcrt/METplus/casper/components/METplotpy/installations/METplotpy-13.0.0

prepend-path PATH /glade/work/dtcrt/METplus/casper/components/METplotpy/installations/METplotpy-13.0.0/metplotpy/contributed
prepend-path PATH /glade/work/dtcrt/METplus/casper/components/METplotpy/installations/METplotpy-13.0.0/metplotpy/plots/performance_diagram
prepend-path PATH /glade/work/dtcrt/METplus/casper/components/METplotpy/installations/METplotpy-13.0.0/metplotpy/plots
prepend-path PATH /glade/work/dtcrt/METplus/casper/components/METplotpy/installations/METplotpy-13.0.0/metplotpy
prepend-path PATH /glade/work/dtcrt/METplus/casper/components/METplotpy/installations/METplotpy-13.0.0
prepend-path PYTHONPATH /glade/work/dtcrt/METplus/casper/components/METplotpy/installations/METplotpy-13.0.0/metplotpy/contributed
prepend-path PYTHONPATH /glade/work/dtcrt/METplus/casper/components/METplotpy/installations/METplotpy-13.0.0/metplotpy/plots/performance_diagram
prepend-path PYTHONPATH /glade/work/dtcrt/METplus/casper/components/METplotpy/installations/METplotpy-13.0.0/metplotpy/plots
prepend-path PYTHONPATH /glade/work/dtcrt/METplus/casper/components/METplotpy/installations/METplotpy-13.0.0/metplotpy
prepend-path PYTHONPATH /glade/work/dtcrt/METplus/casper/components/METplotpy/installations/METplotpy-13.0.0
