#%Module######################################################################
##
##      METplotpy
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the METplotpy-13.0.0.
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

module load intel/2025.2

setenv METPLOTPY_SOURCE /usw/met/METplotpy/METplotpy-13.0.0
setenv METPLOTPY_BASE /usw/met/METplotpy/METplotpy-13.0.0

prepend-path PATH /ncrc/proj/nggps_psd/Julie.Prestopnik/projects/miniconda/miniconda3/envs/metplus_v13.0_py3.14/bin
prepend-path PATH /usw/met/METplotpy/METplotpy-13.0.0/metplotpy/contributed
prepend-path PATH /usw/met/METplotpy/METplotpy-13.0.0/metplotpy/plots/performance_diagram
prepend-path PATH /usw/met/METplotpy/METplotpy-13.0.0/metplotpy/plots
prepend-path PATH /usw/met/METplotpy/METplotpy-13.0.0/metplotpy
prepend-path PATH /usw/met/METplotpy/METplotpy-13.0.0
prepend-path PYTHONPATH /usw/met/METplotpy/METplotpy-13.0.0/metplotpy/contributed
prepend-path PYTHONPATH /usw/met/METplotpy/METplotpy-13.0.0/metplotpy/plots/performance_diagram
prepend-path PYTHONPATH /usw/met/METplotpy/METplotpy-13.0.0/metplotpy/plots
prepend-path PYTHONPATH /usw/met/METplotpy/METplotpy-13.0.0/metplotpy
prepend-path PYTHONPATH /usw/met/METplotpy/METplotpy-13.0.0
